{
    "name": "icontactbv/boekdb.v2.plugin",
    "description": "Wordpress plugin for BoekDBv2 data",
    "type": "wordpress-plugin",
    "authors": [
        {
            "name": "Kevin de Harde",
            "email": "kevin@icontact.nl"
        }
    ],
    "require": {
        "ext-json": "*"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "3.*",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7",
        "phpcompatibility/phpcompatibility-wp": "*",
        "phpunit/phpunit": "^9.6",
        "yoast/wp-test-utils": "^1.2",
        "wp-phpunit/wp-phpunit": "^7.1",
        "roots/wordpress-no-content": "^7.1"
    },
    "scripts": {
        "phpcs": [
            "phpcs -s -p"
        ],
        "phpcs-pre-commit": [
            "phpcs -s -p -n"
        ],
        "phpcbf": [
            "phpcbf -p"
        ],
        "test": [
            "phpunit"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4.33"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BoekDB\\Tests\\": "tests/"
        }
    }
}
